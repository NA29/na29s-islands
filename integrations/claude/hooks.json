{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 -I \"$HOME/.config/herdr-app/mods/sleek-activity/hook.py\" claude prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 -I \"$HOME/.config/herdr-app/mods/sleek-activity/hook.py\" claude reply"
          }
        ]
      }
    ]
  }
}
